#
# Aquarium TinyML – environment template
# Copy this file to ".env" and adjust values for your deployment.
#

# ------------------------------------------------------------------
# MySQL connection used by src/gateway/main (Flask telemetry API)
# ------------------------------------------------------------------
MYSQL_HOST=mysql.csc.edu.vn
MYSQL_PORT=3306
MYSQL_USER=nhom2
MYSQL_PASSWORD=uitstudent
MYSQL_DATABASE=SignalAPI

# Optional overrides for specific schemas
MYSQL_DATABASE_SIGNALAPI=SignalAPI
MYSQL_DATABASE_TINYTRAIN=TinyTrain

# If you prefer to supply the entire SQLAlchemy URL, set this
# variable instead of the individual parameters above.
# Example:
# DATABASE_URL=mysql+pymysql://nhom2:uitstudent@mysql.csc.edu.vn:3306/SignalAPI

# PREDICTION_DATABASE_URL=mysql+pymysql://nhom2:uitstudent@mysql.csc.edu.vn:3306/TinyTrain
